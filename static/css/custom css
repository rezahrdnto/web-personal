/* Bikin tulisan kategori di bawah judul jadi minimalis dan tidak terlalu mencolok */
.post-terms a {
    background: transparent !important;
    color: var(--secondary) !important;
    font-size: 0.85rem;
    padding: 0;
    text-transform: lowercase;
    border: none;
}
.post-terms a:hover {
    color: var(--primary) !important;
    text-decoration: underline;
}